package <%- entityAbsolutePackage %>.service.dto;

import org.junit.jupiter.api.Test;
import static org.assertj.core.api.Assertions.assertThat;
import <%- packageName %>.web.rest.TestUtil;
<%_ let id1;
    let id2;
_%>
<%_ if (!embedded && !primaryKey.composite) { _%>
  <%_ id1 = primaryKey.javaSampleValues[0];
      id2 = primaryKey.javaSampleValues[1];
  _%>
<%_ } %>
<%_ // A composite id is spread over the dto properties, so identity is built by setting each of them.
    const dtoId = {
      // A one-to-one id relationship of a non composite key is a @MapsId: the id is copied, not nested.
      relationships: dtoEntity => dtoEntity.relationships.filter(r => r.id && !(r.relationshipType === 'one-to-one' && !dtoEntity.primaryKey.composite)),
      // Renders the declaration of a dto with its id properties set (an id relationship carries its own dto),
      // as lines so that they can be deduplicated.
      init: (dtoEntity, nbr) => [
        ...dtoId.relationships(dtoEntity).flatMap(r => dtoId.init(r.otherEntity, nbr)),
        `        ${dtoEntity.dtoClass} ${dtoEntity.dtoInstance}${nbr} = new ${dtoEntity.dtoClass}();`,
        ...dtoEntity.fields.filter(f => f.id).map(f => `        ${dtoEntity.dtoInstance}${nbr}.${f.propertyConsumerName}(${nbr === 1 ? f.javaValueSample1 : f.javaValueSample2});`),
        ...dtoId.relationships(dtoEntity).map(r => `        ${dtoEntity.dtoInstance}${nbr}.${r.propertyConsumerName}(${r.otherEntity.dtoInstance}${nbr});`),
      ],
      // The same entity can be reachable through more than one path of the id graph, but must only be declared once.
      render: (dtoEntity, nbr) => [...new Set(dtoId.init(dtoEntity, nbr))].join('\n'),
    };
    const entityDto = { dtoClass, dtoInstance, fields, relationships, primaryKey };
_%>
<%_ if (primaryKey && primaryKey.hasUUID) { _%>
import java.util.UUID;
<%_ } _%>

class <%- dtoClass %>Test {

    @Test
    void dtoEqualsVerifier() throws Exception {
        TestUtil.equalsVerifier(<%- dtoClass %>.class);
<%_ if (!embedded && primaryKey.composite) { _%>
  <%_ const idFields = fields.filter(f => f.id); _%>
  <%_ const idRelationships = dtoId.relationships(entityDto); _%>
<%- dtoId.render(entityDto, 1) %>
<%- dtoId.render(entityDto, 2) %>
        assertThat(<%- dtoInstance %>1).isNotEqualTo(<%- dtoInstance %>2);

        <%- dtoClass %> <%- dtoInstance %>3 = new <%- dtoClass %>();
        assertThat(<%- dtoInstance %>1).isNotEqualTo(<%- dtoInstance %>3);
  <%_ for (const field of idFields) { _%>
        <%- dtoInstance %>3.<%- field.propertyConsumerName %>(<%- dtoInstance %>1.<%- field.propertySupplierName %>());
  <%_ } _%>
  <%_ for (const relationship of idRelationships) { _%>
        <%- dtoInstance %>3.<%- relationship.propertyConsumerName %>(<%- relationship.otherEntity.dtoInstance %>1);
  <%_ } _%>
        assertThat(<%- dtoInstance %>1).isEqualTo(<%- dtoInstance %>3);

        <%- dtoClass %> <%- dtoInstance %>4 = new <%- dtoClass %>();
  <%_ for (const field of idFields) { _%>
        <%- dtoInstance %>4.<%- field.propertyConsumerName %>(null);
  <%_ } _%>
  <%_ for (const relationship of idRelationships) { _%>
        <%- dtoInstance %>4.<%- relationship.propertyConsumerName %>(null);
  <%_ } _%>
        assertThat(<%- dtoInstance %>1).isNotEqualTo(<%- dtoInstance %>4);
<%_ } else if (!embedded) { _%>
        <%- dtoClass %> <%- dtoInstance %>1 = new <%- dtoClass %>();
        <%- dtoInstance %>1.<%- primaryKey.propertyConsumerName %>(<%- id1 %>);
        <%- dtoClass %> <%- dtoInstance %>2 = new <%- dtoClass %>();
        assertThat(<%- dtoInstance %>1).isNotEqualTo(<%- dtoInstance %>2);
        <%- dtoInstance %>2.<%- primaryKey.propertyConsumerName %>(<%- dtoInstance %>1.<%- primaryKey.propertySupplierName %>());
        assertThat(<%- dtoInstance %>1).isEqualTo(<%- dtoInstance %>2);
        <%- dtoInstance %>2.<%- primaryKey.propertyConsumerName %>(<%- id2 %>);
        assertThat(<%- dtoInstance %>1).isNotEqualTo(<%- dtoInstance %>2);
        <%- dtoInstance %>1.<%- primaryKey.propertyConsumerName %>(null);
        assertThat(<%- dtoInstance %>1).isNotEqualTo(<%- dtoInstance %>2);
<%_ } _%>
    }
}
