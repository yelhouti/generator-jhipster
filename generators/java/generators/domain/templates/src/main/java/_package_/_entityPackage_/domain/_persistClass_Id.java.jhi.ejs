package <%- entityAbsolutePackage %>.domain;

import jakarta.persistence.*;
<%_ if (primaryKey.fields.some(field => field.fieldValidate)) { _%>
import jakarta.validation.constraints.*;
<%_ } _%>
import java.io.Serial;
import java.io.Serializable;
import java.util.Objects;
<%_ if (primaryKey.fields.some(field => field.fieldTypeUUID)) { _%>
import java.util.UUID;
<%_ } _%>
<%_ for (const field of primaryKey.fields.filter(field => field.fieldIsEnum)) { _%>
import <%- entityAbsolutePackage %>.domain.enumeration.<%- field.fieldType %>;
<%_ } _%>

/**
 * The composite primary key of the {@link <%- entityAbsoluteClass %>} entity.
 */
@Embeddable
public class <%- primaryKey.type %> implements Serializable {

    @Serial
    private static final long serialVersionUID = 1L;
<%_ for (const field of primaryKey.fields) { _%>

  <%_ if (field.fieldIsEnum) { _%>
    @Enumerated(EnumType.STRING)
  <%_ } _%>
  <%_ if (field.fieldValidate) { _%>
    <%- field.javaFieldValidatorsPartial %>
  <%_ } _%>
    @Column(name = "<%- field.columnName %>"<% if (field.fieldValidationMaxLength) { %>, length = <%- field.fieldValidateRulesMaxlength %><% } %><%- field.fieldValidationRequired ? ', nullable = false' : '' %><%- field.fieldValidationUnique ? ', unique = true' : '' %>)
    private <%- field.javaFieldType %> <%- field.fieldName %>;
<%_ } _%>

    public <%- primaryKey.type %>() {}

    public <%- primaryKey.type %>(<%- primaryKey.fields.map(field => `${field.javaFieldType} ${field.fieldName}`).join(', ') %>) {
<%_ for (const field of primaryKey.fields) { _%>
        this.<%- field.fieldName %> = <%- field.fieldName %>;
<%_ } _%>
    }
<%_ for (const field of primaryKey.fields) { _%>

    public <%- field.javaFieldType %> get<%- field.fieldNameCapitalized %>() {
        return this.<%- field.fieldName %>;
    }

    public void set<%- field.fieldNameCapitalized %>(<%- field.javaFieldType %> <%- field.fieldName %>) {
        this.<%- field.fieldName %> = <%- field.fieldName %>;
    }
<%_ } _%>

    @Override
    public boolean equals(Object o) {
        if (this == o) {
            return true;
        }
        if (!(o instanceof <%- primaryKey.type %>)) {
            return false;
        }

        <%- primaryKey.type %> <%- entityInstance %>Id = (<%- primaryKey.type %>) o;
        return <%- primaryKey.fields.map(field => `Objects.equals(${field.fieldName}, ${entityInstance}Id.${field.fieldName})`).join('\n            && ') %>;
    }

    @Override
    public int hashCode() {
        return Objects.hash(<%- primaryKey.fields.map(field => field.fieldName).join(', ') %>);
    }

    // prettier-ignore
    @Override
    public String toString() {
        return "<%- primaryKey.type %>{" +
<%_ for (const [idx, field] of primaryKey.fields.entries()) { _%>
  <%_ const isQuoted = !field.fieldTypeNumeric; _%>
            "<%- idx === 0 ? '' : ', ' %><%- field.fieldName %>=<%- isQuoted ? "'" : '' %>" + get<%- field.fieldNameCapitalized %>() <%- isQuoted ? '+ "\'" ' : '' %>+
<%_ } _%>
            "}";
    }
}
